# Files that live in the repo but are not part of the published site.
# Read by Cloudflare Workers static assets; gitignore-style syntax.
#
# Without this, `assets.directory: "./"` would serve repo metadata as pages of
# a clinical site — camkit.uk/README.md, camkit.uk/wrangler.jsonc and so on.
# Same reasoning that keeps docs/ out of the repo entirely.
#
# Do NOT add _headers or _redirects here. They are consumed by the platform
# rather than served, and excluding them would silently drop the CSP.

# Every pattern is anchored with a leading slash. This file uses .gitignore
# syntax, where an unanchored `logos/` matches a directory of that name at ANY
# depth — which silently excluded assets/logos/ and deployed the site with both
# institutional logos missing. Anchor everything; match only the repo root.

/README.md
/LICENSE
/.gitignore
/.assetsignore
/wrangler.jsonc
/scripts/

# docs/ and logos/ are .gitignore'd, so a Git-integration build never sees
# them. But `npx wrangler deploy` run from a local checkout uploads whatever is
# in the folder — and your working copy still HAS them. .gitignore does not
# govern asset uploads, so they must be excluded here too or a local deploy
# would publish the maintainer runbook and 1.6 MB of logo originals.
/docs/
/logos/

# Wrangler local state — never part of the site, and cf.json holds the
# IP-geolocation of whoever last ran `wrangler dev`.
/.wrangler/
