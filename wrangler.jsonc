{
  // Cloudflare Workers static-assets config.
  //
  // The site is zero-build: there is no Worker script and no `main` entry
  // point, only static files. Cloudflare serves `directory` directly, which is
  // the Workers equivalent of a Pages project with an empty build command and
  // an output directory of `/`.
  //
  // We are on Workers rather than Pages because Cloudflare has retired the
  // Pages creation flow from the dashboard for new projects. If you do end up
  // on a Pages project instead, DELETE this file — Pages reads wrangler config
  // for Functions and an assets block here will confuse it.
  //
  // Dashboard build settings that go with this file:
  //   Build command:  (empty)
  //   Deploy command: npx wrangler deploy
  //
  // `_headers` and `_redirects` at the project root are honoured by Workers
  // static assets, but VERIFY that after the first deploy — the CSP is a
  // security control and must not be assumed:
  //
  //   curl -sI https://camkit.uk | grep -iE 'content-security-policy|strict-transport'
  //
  // If those headers are missing, add them with a Cloudflare Transform Rule
  // (Rules -> Transform Rules -> Modify Response Header) instead, which works
  // regardless of hosting flow.

  "name": "camkit-uk",

  // Must not be in the future relative to the runtime: a date newer than the
  // workerd binary supports fails to boot with "This Worker requires
  // compatibility date ... but the newest date supported is ...".
  "compatibility_date": "2026-08-11",

  // Routing.
  //
  // preview_urls: false — otherwise every deploy also publishes a public
  // preview hostname. Two problems with that here: GoatCounter counts a
  // *.workers.dev preview (it only skips localhost and private ranges), so
  // preview traffic pollutes the only page-view metric we collect; and it puts
  // unreviewed clinical wording at a findable public URL with no camkit.uk
  // context and no way to stop someone bookmarking it.
  //
  // workers_dev: false — camkit.uk and www.camkit.uk went live as Custom
  // Domains on 2026-08-13, so the Worker no longer needs an address of its
  // own. Turning it off collapses the site to the domain we publish: no third
  // copy at camkit-uk.<account>.workers.dev for someone to find, bookmark or
  // cite, and no third hostname for GoatCounter to count separately. Test
  // locally with `npx wrangler dev` (see docs/deploying.md), not by deploying.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    // ALLOW-LIST, not deny-list. This used to be "./", which published the
    // whole repo root and required an .assetsignore entry for every file that
    // must not be public — README, LICENSE, docs/, logos/, .wrangler/ and,
    // missed until it was live, .git/ (serving /.git/config and /.git/index).
    // Pointing at public/ inverts the default: a file is published only if it
    // is deliberately put here, so accidental publication is structurally
    // impossible rather than a checklist. _headers and _redirects live in
    // here too — Cloudflare reads them from the assets directory root.
    "directory": "./public",

    // Unknown paths return the 404 page rather than silently serving index.html,
    // so a mistyped URL cannot render the calculator at an address that looks
    // official but is not one we published.
    "not_found_handling": "404-page"
  }
}
